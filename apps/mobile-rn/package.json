{
  "name": "mobile-rn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean": "rm -rf node_modules/.cache .expo android/app/build ios/build",
    "clean:android": "cd android && ./gradlew clean && cd .. && rm -rf node_modules/.cache .expo",
    "clean:ios": "cd ios && xcodebuild clean && cd .. && rm -rf node_modules/.cache .expo",
    "build:android": "npm run clean && expo run:android",
    "build:ios": "npm run clean && expo run:ios",
    "build:android:apk": "npm run clean && expo run:android --variant release",
    "test": "jest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.13",
    "@react-navigation/native-stack": "^7.18.5",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-module-scripts": "^56.0.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.79.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "jest": "~29.7.0",
    "typescript": "^5.7.0"
  }
}
