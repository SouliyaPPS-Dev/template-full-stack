# API environment for the React Native app.
# Values are read by app.config.js when starting/building the app.
#
#   APP_ENV: development | production
#     - development: API base is auto-detected from the Expo/Metro host (any LAN)
#     - production:  API base defaults to https://souliya-template.hf.space/api/v1
#
#   API_URL: optional override for the API base URL (takes precedence).
#   APP_NAME: app display name.
#
# Example production build:
#   APP_ENV=production npx expo export --platform web
APP_ENV=development
API_URL=
APP_NAME=Template
