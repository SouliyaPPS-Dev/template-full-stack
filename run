#!/bin/bash
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
PID="$DIR/.api.pid"
AIR_PID="$DIR/.air.pid"
LOG="$DIR/.api.log"

G='\033[0;32m'
Y='\033[1;33m'
R='\033[0;31m'
NC='\033[0m'

running() {
  [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null
}

air_running() {
  [ -f "$AIR_PID" ] && kill -0 "$(cat "$AIR_PID")" 2>/dev/null
}

start_api() {
  running && echo -e "${Y}API already running ($(cat $PID))${NC}" && return 0
  if [ -f "$DIR/services/api-gateway/.env" ]; then
    set -a; source "$DIR/services/api-gateway/.env"; set +a
  fi
  if command -v air >/dev/null 2>&1 || [ -x "$HOME/go/bin/air" ]; then
    echo -e "${G}Starting Go API with air (hot-reload on :8080)...${NC}"
    cd "$DIR/services/api-gateway"
    air > "$LOG" 2>&1 &
    echo $! > "$AIR_PID"
    sleep 3
    air_running && echo -e "${G}API air process running ($(cat $AIR_PID))${NC}" || { echo -e "${R}Failed. tail $LOG${NC}"; exit 1; }
  else
    echo -e "${Y}air not found, falling back to go run...${NC}"
    echo -e "${G}Starting Go API on :8080...${NC}"
    cd "$DIR/services/api-gateway"
    go run ./cmd/... > "$LOG" 2>&1 &
    echo $! > "$PID"
    sleep 2
    running && echo -e "${G}API running ($(cat $PID))${NC}" || { echo -e "${R}Failed. tail $LOG${NC}"; exit 1; }
  fi
}

stop_api() {
  local stopped=0
  if air_running; then
    kill "$(cat "$AIR_PID")" 2>/dev/null; rm -f "$AIR_PID"
    echo -e "${G}Air stopped${NC}"
    stopped=1
  fi
  if running; then
    kill "$(cat "$PID")" 2>/dev/null; rm -f "$PID"
    echo -e "${G}API stopped${NC}"
    stopped=1
  fi
  [ $stopped -eq 0 ] && echo "Not running."
}

case "$1" in
  api)
    case "$2" in
      stop)
        stop_api
        ;;
      status)
        if air_running; then
          echo -e "${G}API: on via air ($(cat $AIR_PID))${NC}"
        elif running; then
          echo -e "${G}API: on ($(cat $PID))${NC}"
        else
          echo -e "${R}API: off${NC}"
        fi
        ;;
      *)
        start_api
        ;;
    esac
    ;;
  web)
    case "$2" in
      build)
        echo -e "${G}Building Web for production...${NC}"
        cd "$DIR/apps/web" && rm -rf dist .output && npx vite build
        echo -e "${G}Build complete → apps/web/.output/public/${NC}"
        ;;
      prod)
        echo -e "${G}Starting Web in PRODUCTION mode (HF API)...${NC}"
        echo -e "${G}API: https://souliya-api-template.hf.space${NC}"
        echo -e "${G}Web: http://localhost:8081${NC}"
        cd "$DIR/apps/web" && VITE_API_URL="https://souliya-api-template.hf.space" npx vite --port 8081 --mode production
        ;;
      dev)
        start_api
        echo -e "${G}Starting Web in DEV mode (local API :8080)...${NC}"
        echo -e "${G}API: http://localhost:8080${NC}"
        echo -e "${G}Web: http://localhost:8081${NC}"
        cd "$DIR/apps/web" && npx vite --port 8081
        ;;
      *)
        start_api
        echo -e "${G}Starting Web (port 8081)...${NC}"
        cd "$DIR/apps/web" && npx vite --port 8081
        ;;
    esac
    ;;
  flutter)
    echo -e "${G}Starting Flutter...${NC}"
    cd "$DIR/apps/mobile-flutter" && flutter pub get && flutter run
    ;;
  rn|mobile-rn)
    case "$2" in
      apk)
        echo -e "${G}Building Android APK (local)...${NC}"
        cd "$DIR/apps/mobile-rn" && bash scripts/build.sh apk
        ;;
      aab|appbundle)
        echo -e "${G}Building Android App Bundle (local)...${NC}"
        cd "$DIR/apps/mobile-rn" && bash scripts/build.sh aab
        ;;
      ios)
        echo -e "${G}Building iOS .app for simulator (local, no signing)...${NC}"
        cd "$DIR/apps/mobile-rn" && bash scripts/build.sh ios
        ;;
      ipa)
        echo -e "${G}Building iOS IPA (local, requires signing)...${NC}"
        cd "$DIR/apps/mobile-rn" && bash scripts/build.sh ipa
        ;;
      build)
        echo -e "${G}Building all platforms (local)...${NC}"
        cd "$DIR/apps/mobile-rn" && bash scripts/build.sh all
        ;;
      eas-apk)
        echo -e "${G}Building Android APK (EAS cloud)...${NC}"
        cd "$DIR/apps/mobile-rn" && eas build --platform android --profile apk --non-interactive
        ;;
      eas-appbundle)
        echo -e "${G}Building Android App Bundle (EAS cloud)...${NC}"
        cd "$DIR/apps/mobile-rn" && eas build --platform android --profile appbundle --non-interactive
        ;;
      eas-ipa)
        echo -e "${G}Building iOS IPA (EAS cloud)...${NC}"
        cd "$DIR/apps/mobile-rn" && eas build --platform ios --profile ipa --non-interactive
        ;;
      login)
        cd "$DIR/apps/mobile-rn" && eas login
        ;;
      *)
        start_api
        echo -e "${G}Starting React Native (Expo)...${NC}"
        cd "$DIR/apps/mobile-rn" && npx expo start
        ;;
    esac
    ;;
  all)
    start_api
    echo ""
    echo "Open separate terminals for:"
    echo "  ./run web          # Web (port 8081)"
    echo "  ./run mobile-rn    # React Native (Expo Go)"
    echo "  ./run flutter      # Flutter"
    ;;
  seed)
    echo -e "${G}Uploading seed data to HF bucket...${NC}"
    bash "$DIR/scripts/seed-bucket.sh"
    ;;
  stop)
    stop_api
    ;;
  *)
    echo ""
    echo -e "${G}Full-Stack Dev Runner${NC}"
    echo ""
    echo "Usage: ./run <command>"
    echo ""
    echo "  ./run api          Start Go API with air (hot-reload :8080)"
    echo "  ./run api stop     Stop Go API"
    echo "  ./run api status   Check API status"
    echo ""
  echo "  ./run web          API + Web dev server (port 8081)"
  echo "  ./run web dev      Web dev mode (local API :8080)"
  echo "  ./run web prod     Web prod mode (HF API :443)"
  echo "  ./run web build    Build web for production"
    echo "  ./run mobile-rn    API + React Native (Expo Go)"
    echo "  ./run mobile-rn apk         Build Android APK (local)"
    echo "  ./run mobile-rn aab         Build Android App Bundle (local)"
    echo "  ./run mobile-rn ios         Build iOS .app (simulator, no signing)"
    echo "  ./run mobile-rn ipa         Build iOS IPA (device, requires signing)"
    echo "  ./run mobile-rn build       Build APK + AAB + iOS .app"
    echo "  ./run mobile-rn eas-apk     Build Android APK (EAS cloud)"
    echo "  ./run mobile-rn eas-ipa     Build iOS IPA (EAS cloud)"
    echo "  ./run mobile-rn login       Login to EAS"
    echo "  ./run flutter      Flutter"
    echo ""
    echo "  ./run all          Start API + instructions"
  echo "  ./run seed         Upload seed data to HF bucket storage"
  echo ""
  echo "  ./run stop         Stop all background services"
  echo ""
  echo "Admin panel: http://localhost:8081/admin"
    echo "Admin login: admin@template.com / admin123"
    echo ""
    ;;
esac
